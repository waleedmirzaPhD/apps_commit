static double chi = -12;
static double kon = 1.E0;
static double koff = 1.E1;
static double deltat   = 1.E-2;
static double mobility = 0.1;
static double epsilon2 = 1E-4;


void LS(Teuchos::RCP<hiperlife::FillStructure> fillStr)  
{
    using namespace hiperlife;

    // Rename variables
    auto& subFill = (*fillStr)["dhand"];
    int DOF   = subFill.numDOFs;
    int eNN   = subFill.eNN;
    int nDim  = subFill.nDim;
    int pDim  = subFill.pDim;
    double *xe_nodes  = subFill.nborCoords.data();
    double *ue_nodes  = subFill.nborDOFs.data();
    double *ue_nodes0 = subFill.nborDOFs0.data();

    // Shape functions and derivatives at Gauss points
    double jac;
    double* Na = subFill.nborBFs();
    vector<double> gNa(eNN*pDim), hNa(eNN*pDim*pDim), lapNa(eNN);
    GlobalBasisFunctions::hessians(gNa.data(), jac, hNa.data(), lapNa.data(), subFill);




    // Values at integration points
    vector<double> x(pDim), gphi(pDim);
    double phi{}, phin{}, lapphi{};
    Array::Fill(x.data(), pDim, 0.0);
    Array::Fill(gphi.data(), pDim, 0.0);
    for (int i = 0; i < eNN; i++)
    {
        // Values
        for (int d = 0; d < pDim; d++)
            x[d] += xe_nodes[nDim*i+d] * Na[i];
        phi  += ue_nodes[DOF*i+0]  * Na[i];
        phin += ue_nodes0[DOF*i+0] * Na[i];

        // Gradients
        for (int d = 0; d < pDim; d++)
            gphi[d] += ue_nodes[DOF*i+0] * gNa[pDim*i+d];

        // Hessians
        for (int d = 0; d < pDim; d++)
            lapphi += ue_nodes[i] * hNa[pDim*pDim*i+pDim*d+d];
    }

    // Double well and derivatives

    double  den = phi*phi - phi;
    double    W = phi * log(phi) + (1-phi)*log(1-phi) + 0.5 * chi * phi * phi;
    double   dW = log(phi/(1-phi)) + chi * phi;
    double  ddW = -1/den + chi;
    double dddW = (2*phi - 1)/(den*den);

    // double a  = 0;
    // double da = 0;
    // double dda= 0;
    // double ddda=0;
    // double    W = chi * phi * phi / (1 + phi * phi) ;
    // double   dW = chi*(2 * phi / (std::pow(phi, 4) + 2 * std::pow(phi, 2) + 1))      ;
    // double  ddW = chi*(-2 * (3 * std::pow(phi, 2) - 1) / (std::pow(phi, 6) + 3 * std::pow(phi, 4) + 3 * std::pow(phi, 2) + 1));
    // double  dddW =  chi*(24 * (std::pow(phi, 3) - phi) / (std::pow(phi, 8) + 4 * std::pow(phi, 6) + 6 * std::pow(phi, 4) + 4 * std::pow(phi, 2) + 1));


    // Fill

    // Fill
    for (int i = 0; i < eNN; i++)
    {
        // Gradient of basis function times gradient of phase-field variable
        double gNagphi{};
        for (int d = 0; d < pDim; d++)
            gNagphi += gNa[pDim*i+d]*gphi[d];

        for (int j = 0; j < eNN; j++)
        {
            // Product of the gradient of basis functions
            double gNagNb{};
            for (int d = 0; d < pDim; d++)
                gNagNb += gNa[pDim*i+d]*gNa[pDim*j+d];

            // Fill Ak
            fillStr->Ak(0, 0)[i*eNN+j] += jac * Na[i] * Na[j] * (1./deltat+koff);
            fillStr->Ak(0, 0)[i*eNN+j] += jac * mobility * dddW * Na[j] * gNagphi;
            fillStr->Ak(0, 0)[i*eNN+j] += jac * mobility * ddW * gNagNb;
            fillStr->Ak(0, 0)[i*eNN+j] += jac * mobility * epsilon2 * lapNa[i] * lapNa[j];
        }
        // Fill RHS
        fillStr->Bk(0)[i] += jac * (Na[i] * ((phi-phin) / deltat - kon + koff * phi) + mobility * (ddW * gNagphi + epsilon2 * lapNa[i] * lapphi));
    }

    // Add to global integral
    fillStr->addToGlobalIntegral("ChemicalFreeEnergy", jac*W);
    fillStr->addToGlobalIntegral("SurfaceFreeEnergy", jac*0.5*epsilon2*Math::SNorm(pDim, gphi.data()));
    fillStr->addToGlobalIntegral("GinzburgLandauFreeEnergy", jac*(W + 0.5*epsilon2*Math::SNorm(pDim, gphi.data())));
    fillStr->addToGlobalIntegral("Mass", jac*phi);
}


int main(int argc, char *argv[])
{
    using namespace std;
    using namespace hiperlife;
    using Teuchos::rcp;
    using Teuchos::RCP;

    //Initialize MPI
    MPI_Init(nullptr, nullptr);

    // Mesh-related parameters
    BasisFuncType bfType = BasisFuncType::SubdivSurfs;
    ElemType eType = ElemType::Triang;
    int bfOrder = 2;
    int gPts = pow(bfOrder+1, computePDim(eType));
    int nEl = 100;

    // Time-related parameters
    string oname = "CahnHilliard.";
    double maxTime  = 10000000;
    double maxNStep = 10000000;
    double maxDelt  = 10000000;
    double stepFactor = 0.95;
    int nSave = 1;

    // // Generate mesh
    // Teuchos::RCP<StructMeshGenerator> structMesh = rcp(new StructMeshGenerator);
    // try
    // {
    //     structMesh->setMesh(eType, bfType, bfOrder);
    //     structMesh->setPeriodicBoundaryCondition({Axis::Xaxis,Axis::Yaxis});
    //     structMesh->genStructMesh(nEl);
    //     // structMesh->translateX(-0.5);
    //     structMesh->scaleX(1);
    //     structMesh->scaleY(1);
    // }
    // catch (runtime_error& err)
    // {
    //     throw runtime_error("Mesh could not be generated.");
    // }

    RCP<MeshLoader> loadedMesh = rcp(new MeshLoader);
    loadedMesh->setElemType(eType);
    loadedMesh->setBasisFuncType(bfType);
    loadedMesh->setBasisFuncOrder(bfOrder);
    loadedMesh->loadLegacyVtk("/Users/mirza/src/hl-base-project/endothelium_modelling_/circle_n3.vtk");    
    loadedMesh->transformFree([](double x, double y) 
    {
            x = 0.2 * x;
            y = 0.2 * y;
            return std::make_tuple(x, y);
    });



    // Create distributed mesh
    RCP<DistributedMesh> disMesh = rcp(new DistributedMesh);
    try
    {
        disMesh->setMesh(loadedMesh);
        disMesh->Update();

        cout << disMesh->myRank() << ":   Distributed Mesh successfully created. " << endl;
    }
    catch (runtime_error& err)
    {
        cout << disMesh->myRank() << ":   Distributed Mesh could not be created. " << err.what() << endl;

        MPI_Finalize();
        return 0;
    }
    int myRank = disMesh->myRank();
    // Print mesh
    disMesh->printFileLegacyVtk("Mesh");

    // DOFsHandler
    Teuchos::RCP<DOFsHandler> dhand = rcp(new DOFsHandler(disMesh));
    try
    {
        dhand->setNameTag("dhand");
        dhand->setDOFs({"rho"});
        dhand->Update();

        cout << dhand->myRank() << ":   DOFsHandler successfully created. " << endl;
    }
    catch (runtime_error& err)
    {
        cout << dhand->myRank() << ":   DOFsHandler could not be created. " << err.what() << endl;

        MPI_Finalize();
        return 0;
    }

    // Initial and boundary conditions
    for (int i = 0; i < dhand->mesh->loc_nPts(); i++)
    {
        double r = ((double) rand() / (RAND_MAX))*2.0-1.0;
        dhand->nodeDOFs0->setValue(0, i, IndexType::Local, kon/koff*(1+0.001*r));
    }
    dhand->UpdateGhosts();

    // Create HiPerProblem
    Teuchos::RCP<HiPerProblem> hiperProbl = rcp(new HiPerProblem);
    try
    {
        // Set DOFHandler
        hiperProbl->setDOFsHandlers({dhand});
        // Set Integration
        hiperProbl->setIntegration("Integ", {"dhand"});
        hiperProbl->setCubatureGauss("Integ", 3);
        // hiperProbl->setElementFillings("Integ", ConsistencyCheck<LS>);
        hiperProbl->setElementFillings("Integ", LS);
        // Set global integral
        hiperProbl->setGlobalIntegrals({"ChemicalFreeEnergy", "SurfaceFreeEnergy", "GinzburgLandauFreeEnergy", "Mass"});
        hiperProbl->setConsistencyCheckDelta(1.E-4);
        hiperProbl->setConsistencyCheckTolerance(1.E-4);
        hiperProbl->setConsistencyCheckType(ConsistencyCheckType::Hessian);
        
        // Update
        hiperProbl->Update();
    }
    catch (runtime_error& err)
    {
        cout << myRank << ": HiPerProblem could not be created " << err.what() << endl;
        MPI_Finalize();
        return 1;
    }

    Teuchos::RCP<MUMPSDirectLinearSolver> linSolver =  rcp(new MUMPSDirectLinearSolver());
    linSolver->setHiPerProblem(hiperProbl);
    linSolver->setMatrixType(MUMPSDirectLinearSolver::MatrixType::General); //General, POD or Symmetric
    linSolver->setAnalysisType(MUMPSDirectLinearSolver::AnalysisType::Parallel); //Sequential or parallel
    linSolver->setOrderingLibrary(MUMPSDirectLinearSolver::OrderingLibrary::Auto); //Many options here
    linSolver->setVerbosity(MUMPSDirectLinearSolver::Verbosity::None);
    linSolver->setDefaultParameters();
    linSolver->setWorkSpaceMemoryIncrease(200);
    linSolver->Update();


    // Create nonlinear solver
    Teuchos::RCP<NewtonRaphsonNonlinearSolver> nonlinSolver =rcp ( new NewtonRaphsonNonlinearSolver());
    nonlinSolver->setLinearSolver(linSolver);
    nonlinSolver->setMaxNumIterations(10);
    nonlinSolver->setResTolerance(1.E-8);
    nonlinSolver->setSolTolerance(1.E-8);
    nonlinSolver->setLineSearch(false);
    nonlinSolver->setConvRelTolerance(false);
    nonlinSolver->setPrintIntermInfo(true);
    nonlinSolver->setPrintSummary(false);
    nonlinSolver->Update();

    // Print initial condition
    dhand->nodeDOFs->setValue(dhand->nodeDOFs0);
    dhand->printFileVtk(oname + to_string(0), true, 0.0);

    // Open file to write global integrals and write headers
    ofstream gIntegFile;
    gIntegFile.open ("globalIntegrals.csv");
    gIntegFile << "TS time deltat";
    for (auto g: hiperProbl->globalIntegralNames())
        gIntegFile << " " << g;
    gIntegFile << endl;

    // Loop over time steps
    double time{0.0};
    int timeStep{0};
    double ener_prev{1.E8};
    while ((timeStep < maxNStep) and (time < maxTime))
    {
        // Write
        if (dhand->myRank() == 0)
            cout << endl << " TS: " << to_string(timeStep) << " Time " << time <<  " Delta " << deltat << endl;

        // Initial guess
        dhand->nodeDOFs->setValue(dhand->nodeDOFs0);
        hiperProbl->UpdateGhosts();

        // Newton-Raphson method
        int ierr = nonlinSolver->solve();

        double max = -10;
        double min = 10;
        for(int i = 0; i < disMesh->loc_nPts(); i++)
        {
            double val = dhand->nodeDOFs->getValue(0,i,IndexType::Local);
            max = std::max(max,val);
            min = std::min(min,val);
        }
        MPI_Allreduce(MPI_IN_PLACE,&max,1,MPI_DOUBLE,MPI_MAX,dhand->comm());
        MPI_Allreduce(MPI_IN_PLACE,&min,1,MPI_DOUBLE,MPI_MIN,dhand->comm());
        
        // Check convergence
        if (ierr != 0 and  max < 1.0 and min > 0.0)
        {
            // Save solution
            dhand->nodeDOFs0->setValue(dhand->nodeDOFs);

            // Update variables
            timeStep ++;
            if (deltat > maxDelt)
                deltat = maxDelt;
            deltat /= stepFactor;
            if (deltat >= maxDelt)
                deltat = maxDelt;
            time += deltat;


            // Write results
            if (timeStep % nSave == 0)
            {
                string solName = oname + to_string(timeStep);
                dhand->printFileVtk(solName, true,time);
            }

 
        }
        else
        {
            // Correct time-step size
            deltat *= stepFactor;
        }

        // Check steady-state
        if (deltat < 1.e-14)
            break;
    }

    // Close file
    gIntegFile.close();

    // Finalize
    //Finalize
    MPI_Finalize();
    return 0;
}

